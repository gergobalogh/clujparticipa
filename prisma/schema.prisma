generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  INFRASTRUCTURE
  EDUCATION
  ENVIRONMENT
  CULTURE
  SAFETY
  TRANSPORT
  HEALTH
  OTHER
}

enum Status {
  SUBMITTED
  UNDER_REVIEW
  ELIGIBLE
  IN_VOTING
  SELECTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  NEEDS_REVISION
  MERGED
  WITHDRAWN
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  FLAGGED
}

enum District {
  MANASTUR
  GHEORGHENI
  ZORILOR
  CENTRU
  MARASTI
  GRIGORESCU
  IRIS
  GRUIA
  ANDREI_MURESANU
  BUNA_ZIUA
  BORHANCI
  DAMBU_ROTUND
  OTHER
}

enum VoteDirection {
  SUPPORT
}

enum ModerationTargetType {
  IDEA
  COMMENT
}

enum ModerationAction {
  HIDE
  RESTORE
  STATUS_CHANGE
  AUTO_FLAG
  APPROVE
}

model Idea {
  id                      String           @id @default(cuid())
  title                   String
  description             String
  category                Category
  latitude                Float
  longitude               Float
  district                District
  status                  Status           @default(SUBMITTED)
  mergedIntoIdeaId        String?
  submitterParticipantHash String?
  notifyOnStatusChange     Boolean          @default(false)
  unsubscribeToken         String?          @unique
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  votes                   Vote[]
  comments                Comment[]
  statusChanges           StatusChange[]
  images                  IdeaImage[]
  feasibilityNote         FeasibilityNote?
  progressUpdates         ProgressUpdate[]
}

model Vote {
  id                   String        @id @default(cuid())
  ideaId               String
  participantHash      String
  direction            VoteDirection @default(SUPPORT)
  notifyOnStatusChange Boolean       @default(false)
  unsubscribeToken     String?       @unique
  createdAt            DateTime      @default(now())
  idea                 Idea          @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, participantHash])
  @@index([participantHash])
}

model Comment {
  id              String        @id @default(cuid())
  ideaId          String
  participantHash String
  text            String
  parentId        String?
  status          CommentStatus @default(VISIBLE)
  createdAt       DateTime      @default(now())
  idea            Idea          @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  parent          Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies         Comment[]     @relation("CommentReplies")

  @@index([ideaId, status])
  @@index([participantHash])
}

model StatusChange {
  id         String   @id @default(cuid())
  ideaId     String
  fromStatus Status?
  toStatus   Status
  note       String
  changedBy  String
  createdAt  DateTime @default(now())
  idea       Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId, createdAt])
}

model ModerationEvent {
  id         String               @id @default(cuid())
  targetType ModerationTargetType
  targetId   String
  action     ModerationAction
  reason     String
  changedBy  String
  createdAt  DateTime             @default(now())

  @@index([targetType, targetId])
}

model IdeaImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  width     Int?
  height    Int?
  mimeType  String
  sizeBytes Int
  order     Int
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ideaId, order])
}

model User {
  id            String                @id @default(cuid())
  name          String?
  email         String?               @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  identity      ParticipantIdentity?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ParticipantIdentity {
  id              String   @id @default(cuid())
  userId          String   @unique
  participantHash String   @unique
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BugReport {
  id              String   @id @default(cuid())
  description     String
  pageUrl         String?
  contactEmail    String?
  participantHash String?
  createdAt       DateTime @default(now())

  @@index([participantHash])
}

model FeasibilityNote {
  id                  String   @id @default(cuid())
  ideaId              String   @unique
  estimatedCostRonMin Int?
  estimatedCostRonMax Int?
  department          String?
  responseText        String
  author              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  idea                Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model DataDeletionRequest {
  id                String    @id @default(cuid())
  confirmationCode  String    @unique
  userId            String?
  provider          String
  providerAccountId String
  status            String    @default("pending")
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([provider, providerAccountId])
}

model VotingConfig {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgressUpdate {
  id        String   @id @default(cuid())
  ideaId    String
  text      String
  imageUrl  String?
  author    String
  createdAt DateTime @default(now())
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId, createdAt])
}
