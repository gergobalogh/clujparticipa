# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/clujparticipa"

# Admin
# Generate with: openssl rand -hex 32
ADMIN_SECRET="change-me"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare Images
# Account ID found in the Cloudflare dashboard sidebar.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
# API token with Cloudflare Images: Edit permission (scoped, not global).
CLOUDFLARE_IMAGES_API_TOKEN="your-api-token-with-images-write-permission"

# Email notifications (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@clujparticipa.ro"
