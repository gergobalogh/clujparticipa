# --- Database ---
# Goes through PgBouncer (session pooling).
# For Vercel: replace host/port with your server's public IP and port 6543.
# connection_limit=1 is important for serverless (each function gets 1 conn from the pool).
# uselibpqcompat=true keeps sslmode=require as "encrypt, don't verify cert" (needed for self-signed cert).
DATABASE_URL="postgresql://clujparticipa:STRONG_PASSWORD@YOUR_SERVER_IP:6543/clujparticipa?sslmode=require&uselibpqcompat=true&connection_limit=1"

# --- Admin ---
# Generate with: openssl rand -hex 32
ADMIN_SECRET="change-me"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Analytics (Umami) ---
# Base URL of the Umami instance, for example https://analytics.example.com.
# Leave unset with NEXT_PUBLIC_UMAMI_WEBSITE_ID to disable analytics.
NEXT_PUBLIC_UMAMI_URL=""
# Website ID from the Umami dashboard. Leave unset with NEXT_PUBLIC_UMAMI_URL to disable analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# --- Cloudflare Images ---
# Account ID found in the Cloudflare dashboard sidebar.
CLOUDFLARE_ACCOUNT_ID="your-account-id"
# API token with Cloudflare Images: Edit permission (scoped, not global).
CLOUDFLARE_IMAGES_API_TOKEN="your-api-token-with-images-write-permission"

# --- Email notifications (Resend) ---
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@clujparticipa.digital"

# --- DB password (used by docker-compose) ---
# Set this in your actual .env file on the server. Overrides the default 'clujparticipa' password.
DB_PASSWORD="STRONG_PASSWORD"
